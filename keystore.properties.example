# Copy to keystore.properties (git-ignored) and fill in your own values.
# Any value can also be provided through the matching environment variable:
#   ZBXMON_KEYSTORE_FILE, ZBXMON_KEYSTORE_PASSWORD, ZBXMON_KEY_ALIAS, ZBXMON_KEY_PASSWORD
storeFile=/path/to/release.jks
storePassword=CHANGE_ME
keyAlias=zbxmon
keyPassword=CHANGE_ME
